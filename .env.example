# Обязателен для production-сборки: абсолютный canonical-домен без завершающего слеша.
NEXT_PUBLIC_SITE_URL=https://utoli11.ru

# true на staging/preview — включает X-Robots-Tag: noindex, nofollow
NEXT_PUBLIC_NOINDEX=false

# Аналитика (пусто = счётчик не подключается)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=

# Верификация вебмастеров (пусто = мета-тег не выводится)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
