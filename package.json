{
  "name": "utoli-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --env-file-if-exists=.env.local scripts/finalize-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "node scripts/prepare-images.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "qr": "node scripts/generate-qr.mjs",
    "assets": "npm run images && npm run qr",
    "check:output": "node scripts/check-output.mjs",
    "shots": "node scripts/screenshots.mjs",
    "audit": "node scripts/audit.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "serve": "node scripts/serve-static.mjs",
    "preview": "npm run build && npm run serve"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@fontsource/manrope": "^5.3.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
